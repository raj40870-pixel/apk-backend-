    "esbuild": "^0.25.12",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.10.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.7.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.3",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "validator": "^13.15.35"
